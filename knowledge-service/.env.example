# Copy to .env and adjust. Every setting is optional - the defaults give you a
# fully working local instance with no external services.

# ---------------------------------------------------------------- profile ---
KB_PROFILE=local                 # local | server
KB_DATA_DIR=./.kbdata            # SQLite + objects + embedded Qdrant + models
KB_DEFAULT_TENANT=default

# --------------------------------------------------------------- metadata ---
# Empty -> sqlite under KB_DATA_DIR. Server profile:
# KB_DATABASE_URL=postgresql+psycopg://kbsvc:CHANGE_ME@localhost:5432/kbsvc
KB_DATABASE_URL=

# --------------------------------------------------------- object storage ---
KB_STORAGE_BACKEND=local         # local | s3
# KB_STORAGE_ROOT=./.kbdata/objects
# KB_S3_ENDPOINT_URL=http://localhost:9000
# KB_S3_BUCKET=kbsvc
# KB_S3_ACCESS_KEY=
# KB_S3_SECRET_KEY=
# KB_S3_REGION=us-east-1

# ------------------------------------------------ vector store (dense half) ---
# Empty -> embedded Qdrant under KB_DATA_DIR/qdrant (local default).
# Server example: KB_QDRANT_URL=http://localhost:6333
KB_QDRANT_URL=
KB_QDRANT_API_KEY=
KB_QDRANT_COLLECTION=kb_chunks

# --------------------------------------------- lexical store (BM25 half) ---
# Tantivy inverted index. Embedded in-process in BOTH profiles - there is no
# server form - and it takes a directory lock, so only one process may write.
# Empty -> KB_DATA_DIR/lexical.
# KB_LEXICAL_DIR=
KB_LEXICAL_WRITER_HEAP_MB=64
# 0 lets tantivy choose. Kept at 1 because concurrent indexing threads create
# and replace segment files at once, which on Windows can lose a race with an
# on-access virus scanner and kill the writer (PermissionDenied on .pos /
# .fieldnorm). Costs ~2x on a full rebuild, nothing on incremental ingest.
# Raise it on Linux, or after excluding KB_DATA_DIR from the scanner.
KB_LEXICAL_WRITER_THREADS=1

# --------------------------------------------------------------- embedding ---
# hash      : offline, deterministic, zero setup (default). Lexical recall comes
#             from the Tantivy BM25 side, which needs no model at all.
# fastembed : local ONNX model, real semantics. pip install '.[fastembed]'
# openai    : any OpenAI-compatible /v1/embeddings endpoint (vLLM, TEI, Ollama...)
KB_DENSE_PROVIDER=hash
KB_DENSE_DIM=384              # ignored by fastembed/openai - the model decides
KB_DENSE_MODEL=BAAI/bge-small-zh-v1.5
KB_DENSE_BATCH_SIZE=32

# Where ONNX weights are cached. Defaults to KB_DATA_DIR/models so a temp-dir
# cleanup cannot delete them.
# KB_MODEL_CACHE_DIR=
# KB_OPENAI_BASE_URL=https://api.openai.com/v1
# KB_OPENAI_API_KEY=

# ----------------------------------------------------------------- parsing ---
# Fallback chain for non-text formats. Plain .txt/.md always use the built-in
# parser. Install extras for the ones you actually need.
KB_PARSER_CHAIN=docling,unstructured,marker

# ----------------------------------------------------- text normalization ---
# Fold traditional and old glyph forms before indexing and before embedding, so
# 陰陽 and 阴阳 retrieve the same passages. Applied to the retrieval
# representation only - stored text is never rewritten, so snippets and
# citations keep the source's own script.
# Changing this requires `kbsvc reembed` (both indexes are affected).
KB_NORMALIZE_CJK=true

# ---------------------------------------------------------------- chunking ---
KB_CHUNK_TARGET_TOKENS=512
KB_CHUNK_OVERLAP_TOKENS=64
KB_CHUNK_MIN_CHARS=80
KB_CHUNK_MAX_CHARS=4000

# --------------------------------------------------------------- retrieval ---
KB_RETRIEVAL_OVERFETCH=4
KB_RRF_K=60
KB_DENSE_WEIGHT=1.0
KB_SPARSE_WEIGHT=1.0
KB_RERANKER=lexical              # none | lexical | cross-encoder
KB_RERANK_MODEL=BAAI/bge-reranker-base
KB_SNIPPET_CHARS=320

# ------------------------------------------------------------------ worker ---
KB_WORKER_POLL_INTERVAL=1.0
KB_WORKER_LEASE_SECONDS=300
KB_WORKER_MAX_ATTEMPTS=3
KB_WORKER_BACKOFF_BASE=5.0
KB_WORKER_BACKOFF_CAP=600.0
# Optional override; derived default is true for local+embedded, false for server.
# KB_API_WORKER_ENABLED=true
KB_API_WORKER_SHUTDOWN_TIMEOUT=30.0

# --------------------------------------------------------------------- api ---
KB_AUTH_REQUIRED=false           # set true for anything reachable off-host
KB_MAX_UPLOAD_BYTES=209715200
KB_ALLOWED_MIMES=                # empty = allow all
KB_API_HOST=127.0.0.1
KB_API_PORT=8077

# --------------------------------------------------------------------- mcp ---
# API key the MCP server authenticates as. Issue with `kbsvc issue-key`.
# KB_MCP_API_KEY=

# ------------------------------------------------- docker-compose (server) ---
# POSTGRES_PASSWORD=
# QDRANT_API_KEY=
# MINIO_ROOT_USER=kbsvc
# MINIO_ROOT_PASSWORD=
# KB_WORKER_REPLICAS=2

# --- 抄袭检测（可选，仅 PostgreSQL，默认关闭）-----------------------------
# 需要 pip install '.[plagiarism]'。SQLite 下相关接口返回 503，其余功能不受影响。
#
# 两个开关刻意独立：indexing 可以先打开把历史语料建好，接口保持对外关闭。
# 默认 false：新部署没有语料，开着无意义。跑完 init/backfill/rebuild-df 并通过
# 验收（清单见 docs/specs/2026-08-07-plagiarism-detection-backend.md）后再置 true。
KB_PLAG_ENABLED=false
KB_PLAG_INDEXING_ENABLED=false

# 算法参数。以下四项参与 algorithm_config_hash，改动会使全部存量投影失效，
# 必须 kbsvc plagiarism rebuild，且重建完成前拒绝创建新检测。
KB_PLAG_SENTENCES_PER_CHUNK=4
KB_PLAG_CHUNK_OVERLAP=1
KB_PLAG_KGRAM=5
KB_PLAG_WINNOW_WINDOW=8

# 以下在查询时作用于未改变的投影，改了不需要重建。
KB_PLAG_MIN_SEED_LEN=30
KB_PLAG_MIN_PASSAGE_LEN=50
KB_PLAG_ZH_MIN_SEED_LEN=12
KB_PLAG_ZH_MIN_PASSAGE_LEN=20
KB_PLAG_MIN_EFFECTIVE_CHARS=12
KB_PLAG_SHORT_EXACT_MIN_SCORE=0.99
KB_PLAG_EXTEND_TOLERANCE=0.85
KB_PLAG_DF_RATIO_THRESHOLD=0.25
KB_PLAG_CANDIDATE_TOP_K=50

# 限额。预算按输入规模缩放：BUDGET_SECONDS 买的是 BUDGET_REFERENCE_CHARS 个字符。
KB_PLAG_MAX_INPUT_CHARS=500000
KB_PLAG_BUDGET_SECONDS=60
KB_PLAG_BUDGET_REFERENCE_CHARS=100000
KB_PLAG_MAX_ACTIVE_CHECKS_PER_KEY=2
KB_PLAG_PREVIEW_CHARS=300

# 任务与 SSE
KB_PLAG_POLL_INTERVAL=1.0
KB_PLAG_LEASE_SECONDS=600
KB_PLAG_MAX_ATTEMPTS=3
KB_PLAG_SSE_POLL_INTERVAL=0.5
KB_PLAG_SSE_KEEPALIVE_INTERVAL=2.0
KB_PLAG_SSE_MAX_SECONDS=900

# 待检原文、报告、事件与停用投影的保留天数
KB_PLAG_RETENTION_DAYS=30
