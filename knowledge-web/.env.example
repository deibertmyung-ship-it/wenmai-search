# kbweb — Flask frontend. Copy to .env and adjust.

# Where kbsvc listens. kbweb never touches the database or Qdrant directly.
KBWEB_API_BASE=http://127.0.0.1:8077

# Forwarded as `Authorization: Bearer ...`. Stays server-side; never reaches
# the browser. Issue one with: python -m kbsvc.cli issue-key kbweb
KBWEB_API_KEY=

KBWEB_TIMEOUT=30
KBWEB_PAGE_SIZE=10
KBWEB_READER_PAGE_SIZE=12

# Allow the UI to request the retrieval debug payload. Turn off in production
# if you do not want raw scores exposed to end users.
KBWEB_DEBUG_UI=true

# Ship no <script> at all. Every page is server-rendered and every control is
# a form or a link, so this is a supported way to run kbweb, not a degraded
# one: the theme follows prefers-color-scheme, the reader pages by link, and
# the retrieval trace renders inline instead of in the drawer. The unit suite
# runs against both settings.
KBWEB_NOJS=false

# Set a fixed value in production, otherwise sessions reset on every restart.
KBWEB_SECRET_KEY=

KBWEB_MAX_UPLOAD_BYTES=209715200
KBWEB_TEMPLATE_RELOAD=false
